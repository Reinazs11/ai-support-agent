APP_NAME="AI Support & Knowledge Agent"
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://support_agent:support_agent@localhost:5432/support_agent
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_knowledge
QDRANT_VECTOR_SIZE=1536

# Local OpenAI authentication. This single key is used for embeddings and chat
# unless provider-specific keys are configured in .env.
OPENAI_API_KEY=

# Embedding provider options: openai, local, disabled.
# Local embeddings are reserved for a future implementation.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Chat provider options: openai, disabled.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.4-nano
# Optional cost estimate rates in USD per 1M tokens. Keep these current with
# your provider pricing; leave as 0 to return token usage without cost estimates.
CHAT_PROMPT_COST_PER_1M_TOKENS=0.20
CHAT_COMPLETION_COST_PER_1M_TOKENS=1.25
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_INITIAL_WAIT_SECONDS=0.25
PROVIDER_RETRY_MAX_WAIT_SECONDS=2.0

# Optional provider-specific keys. Uncomment these only if you need separate
# credentials instead of the shared OPENAI_API_KEY above.
# EMBEDDING_API_KEY=
# CHAT_API_KEY=

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RAG_CONTEXT_MAX_CHARS=6000
# Optional approximate token budget for retrieved context before chat generation.
# Uncomment to enable; leave unset to use only the character budget.
# RAG_CONTEXT_MAX_TOKENS=3000
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads/documents

# n8n webhook boundary. Keep simulated for normal local development.
# Use live only when you intentionally want /agent/respond ticket workflows to
# POST to the configured n8n webhook URL.
# Options: simulated, disabled, live.
N8N_WEBHOOK_MODE=simulated
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SECONDS=5
N8N_WEBHOOK_MAX_RETRIES=0
# Keep true unless you explicitly want live webhook dispatch to run.
N8N_WEBHOOK_REQUIRES_HUMAN_APPROVAL=true

# Agent routing provider options: deterministic, llm.
# Keep deterministic for normal local development and cheap evaluation runs.
# llm uses CHAT_PROVIDER/CHAT_MODEL and falls back to deterministic routing if
# the provider is unavailable or returns an invalid route.
AGENT_ROUTER_PROVIDER=deterministic
AGENT_ROUTER_MODEL=

# Optional tracing. Keep disabled for normal local development and tests.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_HOST=https://cloud.langfuse.com
