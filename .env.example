APP_NAME="AI Support & Knowledge Agent"
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://support_agent:support_agent@localhost:5432/support_agent
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_knowledge
QDRANT_VECTOR_SIZE=1536

# Embedding provider options: openai, local, disabled.
# Local embeddings are reserved for a future implementation.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Backward-compatible OpenAI settings. OPENAI_API_KEY is still accepted for
# embeddings when EMBEDDING_API_KEY is empty and EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MAX_UPLOAD_MB=25
UPLOAD_DIR=uploads/documents

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
